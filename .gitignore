# 忽略所有云函数目录下的node_modules
cloudfunctions/*/node_modules/

# 忽略特定云函数的node_modules（为了向后兼容）
cloudfunctions/convertToMarkdown/node_modules/
cloudfunctions/generateMindmap/node_modules/
cloudfunctions/cleanupFiles/node_modules/
cloudfunctions/getUploadFiles/node_modules/
cloudfunctions/cloudbase_auth/node_modules/

# 忽略miniprogram下的node_modules
miniprogram/node_modules/

# 忽略项目根目录下的node_modules
/node_modules/

# 忽略编辑器和操作系统生成的文件
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# 忽略构建输出和临时文件
dist/
build/
temp/
tmp/

# 忽略日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 忽略环境配置文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 忽略小程序开发工具生成的文件
project.config.json
project.private.config.json

# 忽略云函数的依赖锁定文件（可选）
# cloudfunctions/*/package-lock.json
# cloudfunctions/*/yarn.lock
