.custom-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  outline: none;
  background: #f2f2f2;
  color: #333;
  position: relative;
  overflow: hidden;
}

.custom-button.primary {
  background: #0052d9;
  color: white;
}

.custom-button.danger {
  background: #e34d59;
  color: white;
}

.custom-button.small {
  height: 64rpx;
  font-size: 24rpx;
}

.custom-button.medium {
  height: 80rpx;
}

.custom-button.large {
  height: 96rpx;
  font-size: 32rpx;
}

.custom-button.block {
  display: flex;
  width: 100%;
}

.custom-button.disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.loading {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top: 3rpx solid #fff;
  border-radius: 50%;
  margin-right: 12rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

