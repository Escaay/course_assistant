<view class="content-container">
  <!-- 标签栏 -->
  <view class="tab-container">
    <view 
      class="tab {{activeTab === 0 ? 'active' : ''}} {{disabledTabs[0] ? 'disabled' : ''}}" 
      bindtap="onTabChange" 
      data-index="0"
    >
      文档内容
    </view>
    <view 
      class="tab {{activeTab === 1 ? 'active' : ''}} {{disabledTabs[1] ? 'disabled' : ''}}" 
      bindtap="onTabChange" 
      data-index="1"
    >
      思维导图
    </view>
  </view>
  
  <!-- 文档内容标签页 -->
  <scroll-view 
    scroll-y 
    enhanced="true"
    show-scrollbar="true"
    class="markdown-container" 
    scroll-with-animation="{{!userHasInteracted}}"
    bindtouchstart="handleTouchStart"
    style="display: {{activeTab === 0 ? 'block' : 'none'}}"
  >
    <!-- 使用 towxml 组件渲染 Markdown 内容 -->
    <towxml nodes="{{article}}" />
    
    <!-- 流式加载指示器 -->
    <view class="loading-indicator" wx:if="{{isStreaming && !streamingComplete}}">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text class="loading-text">正在生成内容...</text>
    </view>
  </scroll-view>
  
  <!-- 思维导图标签页 -->
  <view class="mindmap-container" style="display: {{activeTab === 1 ? 'block' : 'none'}}">
    <!-- 思维导图加载状态 - 修改条件，在流式接收或生成过程中都显示 -->
    <view class="mindmap-loading" wx:if="{{isGeneratingMindMap || (isStreaming && !mindmapImage)}}">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text>正在生成思维导图...</text>
    </view>
    
    <image 
      wx:else 
      src="{{mindmapImage}}" 
      mode="aspectFit" 
      class="mindmap-image"
      bindtap="previewMindmap"
      show-menu-by-longpress="true"
    ></image>
    
    <!-- 添加重新生成按钮和保存图片按钮 -->
    <view class="mindmap-actions" wx:if="{{mindmapImage}}">
      <!-- <view class="regenerate-btn" bindtap="regenerateMindmap">
        <view class="regenerate-icon"></view>
        <text>重新生成</text>
      </view> -->
      
      <view class="save-image-btn" bindtap="saveMindmapImage">
        <view class="save-image-icon"></view>
        <text>免费保存</text>
      </view>
    </view>
  </view>
</view>

