<!-- 只有在URL不为空且没有加载错误时才显示web-view -->
<web-view wx:if="{{url && !loadError}}" src="{{url}}"></web-view>

<!-- 加载中提示 -->
<view class="loading-container" wx:if="{{!url && !loadError}}">
  <view class="loading-dots">
    <view class="dot"></view>
    <view class="dot"></view>
    <view class="dot"></view>
  </view>
  <text class="loading-text">正在加载思维导图...</text>
</view>

<!-- 加载错误提示 -->
<view class="error-container" wx:if="{{loadError}}">
  <icon type="warn" size="64"></icon>
  <text class="error-text">{{errorMsg}}</text>
  <button class="back-button" bindtap="goBack">返回</button>
</view> 