.container {
  width: 100%;
  height: 100vh;
  position: relative;
}

.error-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #f8f8f8;
  z-index: 10;
}

.error-text {
  margin: 30rpx 0;
  font-size: 32rpx;
  color: #666;
  text-align: center;
  padding: 0 40rpx;
}

.back-button {
  margin-top: 40rpx;
  background-color: #0052d9;
  color: white;
  font-size: 32rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
} 