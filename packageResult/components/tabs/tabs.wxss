.custom-tabs {
  width: 100%;
}

.tabs-header {
  display: flex;
  border-bottom: 1px solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  color: #666;
}

.tab-item.active {
  color: #0052d9;
  font-weight: 500;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 2px;
  background-color: #0052d9;
}

.tab-item.disabled {
  color: #ccc;
  cursor: not-allowed;
}

.tab-item.disabled.active {
  color: #8eb3e6;
}

.tab-item.disabled.active::after {
  background-color: #8eb3e6;
}

.tabs-content {
  padding: 16px 0;
} 