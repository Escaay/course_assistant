/**index.wxss**/
page {
  height: 100%;
  background-color: #f8f9fa;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  width: 100%;
  padding-bottom: 80rpx;
  overflow-x: hidden;
}

.scrollarea {
  height: 100%;
  overflow-y: auto;
  width: 100%;
}

.container {
  padding: 40rpx;
  padding-bottom: 150rpx;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 20rpx 0;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  letter-spacing: 1px;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
}

.upload-section {
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
  overflow: hidden;
  flex-shrink: 0; /* 防止被压缩 */
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  margin: 20rpx;
  transition: all 0.3s ease;
}

.upload-area:active {
  background-color: #f0f7ff;
  border-color: #0052d9;
}

.upload-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin: 20rpx 0 10rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.file-list {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: calc(100% - 80rpx);
  box-sizing: border-box;
  align-self: center;
  flex-shrink: 0; /* 防止被压缩 */
}

.file-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.file-count {
  font-size: 28rpx;
  color: #0052d9;
  font-weight: 500;
  background-color: #f0f7ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.file-items {
  max-height: 60vh;
  overflow-y: auto;
}

.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.file-item:last-child {
  border-bottom: none;
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

.file-icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: white;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pdf-icon {
  background-color: #e74c3c;
}

.doc-icon {
  background-color: #3498db;
}

.file-details {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.file-size {
  font-size: 24rpx;
  color: #999;
}

.delete-btn {
  padding: 10rpx;
  margin-left: 20rpx;
}

.action-area {
  margin-top: 40rpx;
  flex-shrink: 0; /* 防止被压缩 */
}

.convert-btn {
  border-radius: 12rpx;
  overflow: hidden;
  font-weight: 500;
  letter-spacing: 1px;
  height: 90rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 82, 217, 0.15);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.t-icon-loading {
  animation: spin 1s linear infinite;
}
