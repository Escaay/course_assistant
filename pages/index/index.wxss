/**index.wxss**/
page {
  height: 100%;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  width: 100%;
  padding-bottom: 80rpx;
  overflow-x: hidden;
}

.scrollarea {
  height: 100%;
  overflow-y: auto;
  width: 100%;
  scroll-behavior: smooth;
}

.container {
  padding: 40rpx;
  padding-bottom: 150rpx;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-direction: column;
  animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 20rpx 0;
  width: 100%;
  position: relative;
}

.header::before {
  content: '';
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120%;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(0, 82, 217, 0.1) 0%, rgba(0, 82, 217, 0.05) 100%);
  border-radius: 0 0 50% 50%;
  z-index: -1;
}

.logo-container {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  transform: perspective(800rpx) rotateX(10deg);
  transition: all 0.3s ease;
  animation: float 6s ease-in-out infinite;
  background-color: rgba(255, 255, 255, 0.1);
  position: relative;
}

.logo:empty::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, rgba(0, 82, 217, 0.05) 25%, rgba(0, 82, 217, 0.1) 50%, rgba(0, 82, 217, 0.05) 75%);
  background-size: 200% 100%;
  animation: shimmerPlaceholder 1.5s infinite linear;
  border-radius: inherit;
}

@keyframes shimmerPlaceholder {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

@keyframes float {
  0%, 100% {
    transform: perspective(800rpx) rotateX(10deg) translateY(0);
  }
  50% {
    transform: perspective(800rpx) rotateX(10deg) translateY(-20rpx);
  }
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  letter-spacing: 2px;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  background: linear-gradient(120deg, #0052d9, #00a6ff);
  -webkit-background-clip: text;
  color: transparent;
  animation: shimmer 2s infinite linear;
  background-size: 200% 100%;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.slogan-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.slogan {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  padding: 12rpx 30rpx;
  background: linear-gradient(120deg, #f0f7ff, #e6f3ff);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.08);
  animation: slideIn 0.5s ease-out backwards;
  position: relative;
  overflow: hidden;
}

.slogan::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    120deg,
    transparent,
    rgba(255, 255, 255, 0.6),
    transparent
  );
  animation: shine 3s infinite;
}

@keyframes shine {
  to {
    left: 200%;
  }
}

.slogan:nth-child(1) { animation-delay: 0.2s; }
.slogan:nth-child(2) { animation-delay: 0.4s; }
.slogan:nth-child(3) { animation-delay: 0.6s; }

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.upload-section {
  background-color: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 40rpx;
  overflow: hidden;
  flex-shrink: 0;
  transform: translateZ(0);
  transition: all 0.3s ease;
}

.upload-section:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  border: 2rpx dashed rgba(0, 82, 217, 0.3);
  border-radius: 16rpx;
  margin: 20rpx;
  transition: all 0.3s ease;
  background: radial-gradient(circle at center, rgba(0, 82, 217, 0.03) 0%, transparent 70%);
}

.upload-area:active {
  background-color: rgba(0, 82, 217, 0.08);
  border-color: #0052d9;
  transform: scale(0.98);
}

.upload-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin: 20rpx 0 10rpx;
  background: linear-gradient(120deg, #333, #666);
  -webkit-background-clip: text;
  color: transparent;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  opacity: 0.8;
}

.file-list {
  background-color: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  width: calc(100% - 30rpx);
  box-sizing: border-box;
  align-self: center;
  flex-shrink: 0;
  animation: slideUp 0.5s ease-out;
  backdrop-filter: blur(10rpx);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.file-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 40%;
  height: 4rpx;
  background: linear-gradient(90deg, #0052d9, transparent);
  border-radius: 2rpx;
}

.file-count {
  font-size: 28rpx;
  color: #0052d9;
  font-weight: 500;
  background: linear-gradient(120deg, #f0f7ff, #e6f3ff);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 82, 217, 0.15);
}

.file-items {
  max-height: 60vh;
  overflow-y: auto;
  padding-right: 10rpx;
}

.file-items::-webkit-scrollbar {
  width: 6rpx;
}

.file-items::-webkit-scrollbar-thumb {
  background-color: rgba(0, 82, 217, 0.2);
  border-radius: 3rpx;
}

.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.file-item:hover {
  transform: translateX(10rpx);
  background-color: rgba(0, 82, 217, 0.02);
}

.file-icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: white;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.file-icon::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.2) 0%, transparent 60%);
  animation: rotate 4s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.pdf-icon {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
}

.doc-icon {
  background: linear-gradient(135deg, #3498db, #2980b9);
}

.convert-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #0052d9, #0066ff);
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 1px;
  box-shadow: 0 8rpx 20rpx rgba(0, 82, 217, 0.25);
  border: none;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.convert-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.2) 0%, transparent 60%);
  animation: rotate 4s linear infinite;
}

.convert-btn:active:not(.convert-btn-disabled) {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(0, 82, 217, 0.2);
}

.convert-btn-disabled {
  background: linear-gradient(135deg, #cccccc, #999999) !important;
  color: rgba(255, 255, 255, 0.8) !important;
  box-shadow: none !important;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.t-icon-loading {
  animation: spin 1s linear infinite;
}
